<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure adapters: worker IPC, persistence, cache, logging, configuration.
    Depends only on GlyphLens.Core. Contains no UI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GlyphLens.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlyphLens.Core\GlyphLens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hash-locked engine packages the one-click setup installs (generated, see docs/DEVELOPMENT.md "Engine lock file"). -->
    <EmbeddedResource Include="..\..\worker\requirements\engines.lock.txt" LogicalName="GlyphLens.Setup.engines.lock.txt" Link="Setup\engines.lock.txt" />
  </ItemGroup>

</Project>
