<Window x:Class="GlyphLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GlyphLens.App.ViewModels"
        xmlns:views="clr-namespace:GlyphLens.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding ProductName}"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="G" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding VersionInfo}" Style="{StaticResource MutedText}" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Body: capture on the left, worker and about on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <views:CaptureView DataContext="{Binding Capture}" />
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <views:OcrView DataContext="{Binding Ocr}" />
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <views:WorkerView DataContext="{Binding Worker}" />
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="About this build" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding FoundationStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FeatureStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
