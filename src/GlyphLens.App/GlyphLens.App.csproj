<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF desktop shell (MVVM). Composition root of the application.
    Must not contain OCR, translation or detection engine logic.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GlyphLens.App</RootNamespace>
    <AssemblyName>GlyphLens</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The brand mark (blue rounded square, white G), drawn by tools/make-icon.py: the exe's icon and the main window's icon. -->
    <ApplicationIcon>Assets\GlyphLens.ico</ApplicationIcon>
    <!-- WPF0001: Application.ThemeMode (Fluent dark theme) is an experimental WPF API in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlyphLens.Core\GlyphLens.Core.csproj" />
    <ProjectReference Include="..\GlyphLens.Windows\GlyphLens.Windows.csproj" />
    <ProjectReference Include="..\GlyphLens.Infrastructure\GlyphLens.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the update feed is and the public key that verifies it (empty = updates not set up: nothing is ever checked). -->
    <EmbeddedResource Include="Updates\update-config.json" LogicalName="GlyphLens.UpdateConfig.json" />
    <Resource Include="Assets\GlyphLens.ico" />
  </ItemGroup>

</Project>
