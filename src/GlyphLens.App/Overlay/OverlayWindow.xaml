<Window x:Class="GlyphLens.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GlyphLens.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="GlyphLens overlay"
        AutomationProperties.AutomationId="GlyphLensOverlayWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Focusable="False"
        Topmost="{Binding IsPinned}"
        Opacity="{Binding Opacity}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Width="400" Height="560" MinWidth="320" MinHeight="64"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Header buttons: round, a grey glyph, a soft grey disc on hover (Apple's plain toolbar buttons). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OverlayBubbleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One translation: a soft grey bubble; the original small and grey above, the translation larger and bold below. -->
        <DataTemplate DataType="{x:Type vm:OverlayCard}">
            <Border Background="{DynamicResource OverlayBubbleBrush}" CornerRadius="12" Padding="12,10,8,6" Margin="0,0,0,8"
                    AutomationProperties.AutomationId="OverlayCard" AutomationProperties.Name="{Binding Original}">
                <StackPanel>
                    <TextBox Text="{Binding Original, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"
                             FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             AutomationProperties.AutomationId="OverlayCardOriginal" />
                    <TextBox Text="{Binding Translated, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" FontWeight="SemiBold" Margin="0,4,4,0"
                             FontSize="{Binding DataContext.TranslationFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.AutomationId="OverlayCardTranslation" />
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11" Margin="0,6,4,0"
                               Foreground="{DynamicResource WarningTextBrush}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="OverlayCardNote" />
                    <!-- language, time and OCR confidence (shortened first when narrow), then the two copy actions -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Details}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" ToolTip="Copy the original text" Margin="4,0,0,0"
                                Command="{Binding DataContext.CopyOriginalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.AutomationId="OverlayCopyOriginal" AutomationProperties.Name="Copy original">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,1,4,0" />
                                <TextBlock Text="Original" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" ToolTip="Copy the translation"
                                Command="{Binding DataContext.CopyTranslationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.AutomationId="OverlayCopyTranslation" AutomationProperties.Name="Copy translation">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,1,4,0" />
                                <TextBlock Text="Translation" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- The outer margin leaves room for the soft shadow. -->
    <Grid Margin="10">
        <!-- A floating panel: near-white, generously rounded, a hairline edge and a wide soft shadow. -->
        <Border Background="{DynamicResource OverlaySurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.18" Color="{StaticResource ShadowColor}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: icon, name, languages, activity, controls. It is also the drag handle. -->
                <Border x:Name="Header" Grid.Row="0" Background="Transparent" Padding="12,10,8,8" AutomationProperties.AutomationId="OverlayHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="G" FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="GlyphLens" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="OverlayLanguages">
                                <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding TargetText, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0" AutomationProperties.AutomationId="OverlayState"
                                        AutomationProperties.Name="{Binding StateText}">
                                <Ellipse Width="8" Height="8" Margin="0,1,5,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateLevel}" Value="Ok">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateLevel}" Value="Attention">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateLevel}" Value="Problem">
                                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.AutomationId="OverlayStateText" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Collapse or expand" Command="{Binding ToggleCollapsedCommand}"
                                    AutomationProperties.AutomationId="OverlayCollapseButton" AutomationProperties.Name="Collapse" />
                            <Button Style="{StaticResource IconButton}" ToolTip="Pin above other windows" Command="{Binding TogglePinnedCommand}"
                                    AutomationProperties.AutomationId="OverlayPinButton" AutomationProperties.Name="Pin">
                                <TextBlock Text="&#xE718;" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Open GlyphLens settings" Command="{Binding SettingsCommand}"
                                    AutomationProperties.AutomationId="OverlaySettingsButton" AutomationProperties.Name="Settings" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Hide the overlay (Ctrl+Alt+O shows it again)" Command="{Binding HideCommand}"
                                    AutomationProperties.AutomationId="OverlayHideButton" AutomationProperties.Name="Hide" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body: the translation workspace. -->
                <Grid Grid.Row="1" x:Name="Body" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Notices}" Margin="10,0,10,6"
                                  Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0" CornerRadius="10" Padding="10,7" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.AutomationId="OverlayNotice" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer x:Name="CardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,0,10,0" Focusable="False" CanContentScroll="True" ScrollChanged="OnCardsScrollChanged" AutomationProperties.AutomationId="OverlayCardsScroll">
                        <ItemsControl x:Name="CardsList" ItemsSource="{Binding Cards}" AutomationProperties.AutomationId="OverlayCardsList" AutomationProperties.Name="Translations">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Style="{StaticResource PillButton}"
                            Visibility="{Binding HasUnseenResults, Converter={StaticResource BoolToVisibility}}" Click="OnShowNewResultsClick"
                            AutomationProperties.AutomationId="OverlayNewResultsButton" AutomationProperties.Name="Show new results">
                        <TextBlock Text="&#x2193; New results" />
                    </Button>

                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                          Visibility="{Binding HasNoCards, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
                        <TextBlock Text="Translations of the text on your screen appear here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Cancel" Style="{StaticResource LinkButton}" Command="{Binding CancelClearCommand}"
                                            Visibility="{Binding IsConfirmingClear, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.AutomationId="OverlayClearCancelButton" />
                                    <Button Style="{StaticResource LinkButton}" Command="{Binding ClearSessionCommand}"
                                            AutomationProperties.AutomationId="OverlayClearButton">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Clear" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfirmingClear}" Value="True">
                                                            <Setter Property="Text" Value="Clear all?" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0">
                                    <Button Content="A&#x2212;" Style="{StaticResource LinkButton}" Command="{Binding DecreaseFontCommand}" ToolTip="Smaller text"
                                            AutomationProperties.AutomationId="OverlayFontSmallerButton" AutomationProperties.Name="Smaller text" />
                                    <Button Content="A+" Style="{StaticResource LinkButton}" Command="{Binding IncreaseFontCommand}" ToolTip="Larger text"
                                            AutomationProperties.AutomationId="OverlayFontLargerButton" AutomationProperties.Name="Larger text" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding ToggleInteractiveCommand}"
                                        AutomationProperties.AutomationId="OverlayModeButton" AutomationProperties.Name="Input mode">
                                    <TextBlock Text="{Binding ModeText}" />
                                </Button>
                                <TextBlock Text="Opacity" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <!-- the slider takes the space that is left (up to 96 DIP), so at the minimum width it shrinks instead of running under the buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" MaxWidth="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource AppleSlider}" MinHeight="24" Minimum="0.35" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" Focusable="False"
                                            AutomationProperties.AutomationId="OverlayOpacitySlider" AutomationProperties.Name="Opacity" />
                                </Grid>
                            </DockPanel>
                            <!-- stacked, so a status that wraps pushes the protection line down instead of overlapping it -->
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverlayStatusText">
                                    <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding StatusMessage, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding CaptureProtectionText}"
                                           AutomationProperties.AutomationId="OverlayProtectionText" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
