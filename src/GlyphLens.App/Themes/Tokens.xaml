<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Tokens that do not change between the light and the dark appearance: typography and shape (DESIGN.md section 2).
        The colours are in Palette.Light.xaml and Palette.Dark.xaml.
    -->

    <!-- Segoe UI Variable (Windows' counterpart of Apple's system font) with a CJK-capable fallback; sizes in DIPs. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="TitleFontSize">26</sys:Double>
    <sys:Double x:Key="SectionFontSize">15</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="LabelFontSize">11</sys:Double>

    <!-- Shape: generous, continuous-looking rounding. -->
    <CornerRadius x:Key="SectionCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">16</CornerRadius>
</ResourceDictionary>
