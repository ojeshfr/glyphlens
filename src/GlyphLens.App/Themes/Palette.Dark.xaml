<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The DARK colour palette (DESIGN.md, "Colour tokens"). Palette.Light.xaml and Palette.Dark.xaml are the ONLY files
        with literal colour values and define exactly the same keys; the app swaps one for the other at run time, so every view
        refers to the brushes with DynamicResource. Tests enforce all three rules and the contrast of the text pairs.
    -->

    <!-- Main application background -->
    <Color x:Key="WindowBackgroundColor">#1C1C1E</Color>
    <!-- Sections and content surfaces -->
    <Color x:Key="SurfaceColor">#2C2C2E</Color>
    <!-- Subtle inner surfaces -->
    <Color x:Key="SurfaceSecondaryColor">#242426</Color>
    <!-- Main text -->
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
    <!-- Supporting labels (AA on every background used) -->
    <Color x:Key="TextSecondaryColor">#AEAEB2</Color>
    <!-- Tertiary, non-essential information only (below AA) -->
    <Color x:Key="TextMutedColor">#8E8E93</Color>
    <!-- Hairlines and section edges -->
    <Color x:Key="BorderSubtleColor">#3A3A3C</Color>
    <!-- Fills: primary buttons, selection, switches (white text on it) -->
    <Color x:Key="AccentColor">#0A64D8</Color>
    <!-- Hover / pressed fill -->
    <Color x:Key="AccentHoverColor">#0957BD</Color>
    <!-- Accent as text, icons and the focus ring (readable on the surfaces) -->
    <Color x:Key="AccentTextColor">#64B5FF</Color>
    <!-- Ready / connected -->
    <Color x:Key="SuccessColor">#30D158</Color>
    <!-- Attention required -->
    <Color x:Key="WarningColor">#FF9F0A</Color>
    <!-- Errors and failures -->
    <Color x:Key="ErrorColor">#FF6961</Color>
    <!-- Text on Accent -->
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <!-- Symbols on Success / Warning / Error badges -->
    <Color x:Key="OnStatusColor">#1C1C1E</Color>
    <!-- Warning text -->
    <Color x:Key="WarningTextColor">#FFB340</Color>
    <!-- Error text -->
    <Color x:Key="ErrorTextColor">#FF8A80</Color>
    <!-- Tinted background (information notices) -->
    <Color x:Key="AccentSubtleColor">#10294A</Color>
    <!-- Tinted background (warnings) -->
    <Color x:Key="WarningSubtleColor">#3D2A0E</Color>
    <!-- Tinted background (errors) -->
    <Color x:Key="ErrorSubtleColor">#3D1A1A</Color>
    <!-- Hover on a surface -->
    <Color x:Key="SurfaceHoverColor">#3A3A3C</Color>
    <!-- Pressed on a surface -->
    <Color x:Key="SurfacePressedColor">#48484A</Color>
    <!-- Stronger edges (slider knob) -->
    <Color x:Key="BorderStrongColor">#545458</Color>
    <!-- Behind the capture preview -->
    <Color x:Key="PreviewBackdropColor">#0F0F10</Color>
    <!-- The sidebar -->
    <Color x:Key="SidebarBackgroundColor">#232325</Color>
    <!-- Hover in the sidebar -->
    <Color x:Key="SidebarHoverColor">#303033</Color>
    <!-- Grey buttons and the segmented track -->
    <Color x:Key="ControlFillColor">#3A3A3C</Color>
    <!-- Hover on grey controls -->
    <Color x:Key="ControlFillHoverColor">#444447</Color>
    <!-- Pressed grey controls; the inactive sidebar selection -->
    <Color x:Key="ControlFillPressedColor">#505053</Color>
    <!-- A switch that is off -->
    <Color x:Key="SwitchOffColor">#48484A</Color>
    <!-- The overlay panel (slightly translucent) -->
    <Color x:Key="OverlaySurfaceColor">#F22C2C2E</Color>
    <!-- A translation bubble in the overlay -->
    <Color x:Key="OverlayBubbleColor">#3A3A3C</Color>
    <!-- The chosen segment of a segmented control -->
    <Color x:Key="SegmentSelectedColor">#636366</Color>
    <!-- The knob of a switch or a slider -->
    <Color x:Key="KnobColor">#E5E5EA</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="OnStatusBrush" Color="{StaticResource OnStatusColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource ErrorSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="{StaticResource PreviewBackdropColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="{StaticResource SwitchOffColor}" />
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="{StaticResource OverlaySurfaceColor}" />
    <SolidColorBrush x:Key="OverlayBubbleBrush" Color="{StaticResource OverlayBubbleColor}" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="{StaticResource SegmentSelectedColor}" />
    <SolidColorBrush x:Key="KnobBrush" Color="{StaticResource KnobColor}" />
    <SolidColorBrush x:Key="ShadowSoftBrush" Color="{StaticResource ShadowColor}" Opacity="0.12" />

    <!-- The Fluent theme otherwise takes its accent from the Windows accent colour (any colour the user picked): use ours. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentTextColor}" />
</ResourceDictionary>
