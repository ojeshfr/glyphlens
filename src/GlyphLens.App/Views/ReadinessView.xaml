<UserControl x:Class="GlyphLens.App.Views.ReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GlyphLens.App.ViewModels"
             xmlns:local="clr-namespace:GlyphLens.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReadinessViewModel}"
             d:DesignWidth="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            A status badge: a filled circle whose colour AND symbol follow the level (check, "!", "x", "-"), so the level is never
            shown by colour alone; the level is also written out in the detail text.
        -->
        <Style x:Key="LevelBadge" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Attention">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Problem">
                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource OnStatusBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="&#xE738;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Ok">
                    <Setter Property="Text" Value="&#xE73E;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Attention">
                    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                    <Setter Property="Text" Value="!" />
                    <Setter Property="FontSize" Value="13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Problem">
                    <Setter Property="Text" Value="&#xE711;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Readiness" Style="{StaticResource SectionTitle}" />
            <Button Content="Re-check" Command="{Binding RecheckCommand}" HorizontalAlignment="Right" Padding="14,4" MinHeight="28"
                    AutomationProperties.AutomationId="ReadinessRecheckButton" AutomationProperties.Name="Re-check readiness" />
        </Grid>

        <StackPanel Margin="0,6,0,8">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="ReadinessSummary" />
            <TextBlock Text="{Binding SummaryDetail}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                       AutomationProperties.AutomationId="ReadinessSummaryDetail" />
        </StackPanel>

        <!-- "Install everything": only when something is missing, and only after the user confirmed what will be downloaded -->
        <local:SetupPanel DataContext="{Binding Setup}" Margin="0,0,0,10"
                          Visibility="{Binding DataContext.HasSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" AlternationCount="1000"
                      AutomationProperties.AutomationId="ReadinessList" AutomationProperties.Name="Readiness checks">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <!-- a hairline above every row but the first -->
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="32,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource LevelBadge}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource LevelGlyph}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" AutomationProperties.AutomationId="{Binding Id, StringFormat='ReadinessTitle-{0}'}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0"
                                           AutomationProperties.AutomationId="{Binding Id, StringFormat='Readiness-{0}'}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding Action}" Margin="12,0,0,0" Padding="14,4" MinHeight="28"
                                    VerticalAlignment="Center" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.AutomationId="{Binding Id, StringFormat='ReadinessAction-{0}'}" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
