<UserControl x:Class="GlyphLens.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GlyphLens.App.Controls"
             xmlns:models="clr-namespace:GlyphLens.Core.Models;assembly=GlyphLens.Core"
             xmlns:vm="clr-namespace:GlyphLens.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CaptureViewModel}"
             d:DesignHeight="620"
             d:DesignWidth="760">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Status indicator: colour follows the capture service's actual state. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource StatusIdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CaptureStatus.Capturing}">
                    <Setter Property="Fill" Value="{StaticResource StatusOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CaptureStatus.Starting}">
                    <Setter Property="Fill" Value="{StaticResource StatusBusyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CaptureStatus.Stopping}">
                    <Setter Property="Fill" Value="{StaticResource StatusBusyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:CaptureStatus.Faulted}">
                    <Setter Property="Fill" Value="{StaticResource StatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and status -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Screen capture" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,20,0" AutomationProperties.AutomationId="CaptureStatusText" />
                <Button Content="Start capture" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="16,5"
                        AutomationProperties.AutomationId="StartCaptureButton" />
                <Button Content="Stop" Command="{Binding StopCommand}" Padding="16,5"
                        AutomationProperties.AutomationId="StopCaptureButton" AutomationProperties.Name="Stop capture" />
            </StackPanel>
        </Grid>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                <RadioButton Content="Display" IsChecked="{Binding IsDisplayKind}" IsEnabled="{Binding CanChooseTarget}" Margin="0,0,12,0"
                             AutomationProperties.AutomationId="TargetKindDisplay" />
                <RadioButton Content="Window" IsChecked="{Binding IsWindowKind}" IsEnabled="{Binding CanChooseTarget}"
                             AutomationProperties.AutomationId="TargetKindWindow" />
            </StackPanel>

            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Label"
                      IsEnabled="{Binding CanChooseTarget}" MinWidth="200"
                      AutomationProperties.AutomationId="TargetSelector" AutomationProperties.Name="Capture target" />

            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="12,5"
                    AutomationProperties.AutomationId="RefreshButton" />
        </Grid>

        <!-- Live preview -->
        <Border Grid.Row="2" Background="#0A0A0B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="220">
            <Grid>
                <controls:CapturePreview FrameSource="{Binding Frames}"
                                         AutomationProperties.AutomationId="CapturePreview" AutomationProperties.Name="Live capture preview" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="No capture running" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose a display or window, then press Start capture." Style="{StaticResource MutedText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Frame information and errors -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="TARGET" Style="{StaticResource InfoLabel}" />
                    <TextBlock Text="{Binding TargetInfoText}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TargetInfoText" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="FRAME SIZE" Style="{StaticResource InfoLabel}" />
                    <TextBlock Text="{Binding FrameSizeText}" AutomationProperties.AutomationId="FrameSizeText" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="FRAME #" Style="{StaticResource InfoLabel}" />
                    <TextBlock Text="{Binding FrameSequenceText}" AutomationProperties.AutomationId="FrameSequenceText" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,12,0,0" ToolTip="{Binding ErrorDetail}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="CaptureErrorText" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
